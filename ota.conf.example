# Copy to ~/.config/ios-ota/ota.conf on the build Mac (as the user that runs the GitHub runner)
# and fill in. Environment variables with the same names override these values.
# Never commit the filled-in file.

# Public address of the install page, as the iPhone sees it (HTTPS is required for OTA).
# With Tailscale on the NAS: https://<nas-machine-name>.<your-tailnet>.ts.net
OTA_BASE_URL=https://nas.example-tailnet.ts.net

# Where the site files are uploaded, over SSH (the default and tested setup):
OTA_RSYNC_DEST=ota-uploader@nas.local:/volume1/ios-ota/www
# SSH private key and port.
OTA_SSH_KEY=~/.ssh/ota_uploader
#OTA_SSH_PORT=22

# Alternative: the Synology rsync service. It refused every account in testing
# ("account system disabled"), so prefer SSH.
#OTA_RSYNC_DEST=rsync://ota-uploader@nas.local/ios-ota/www
#OTA_RSYNC_PASSWORD_FILE=~/.config/ios-ota/rsync.password

# rsync binary. macOS's own rsync (openrsync) is not enough: brew install rsync.
# Use /usr/local/bin/rsync on an Intel Mac.
OTA_RSYNC_BIN=/opt/homebrew/bin/rsync

# Versions kept per app on the server.
OTA_KEEP_VERSIONS=10

# Apple team that signs the build. Leave empty to use the project's DEVELOPMENT_TEAM.
#OTA_TEAM_ID=

# Export method: debugging (development profile, works with a free team) or
# release-testing (Ad Hoc, paid Apple Developer Program).
OTA_EXPORT_METHOD=debugging

# Unlock the signing keychain before each build. A runner service can find the login keychain
# locked, and codesign then fails with errSecInternalComponent.
# The file holds the runner user's login password and must be chmod 600 (README, Runner Mac step 4).
OTA_KEYCHAIN_PASSWORD_FILE=~/.config/ios-ota/keychain.password
# Keychain to unlock; defaults to the runner user's login keychain.
#OTA_KEYCHAIN=~/Library/Keychains/login.keychain-db

# Used for the expiry date only when the IPA carries no provisioning profile.
OTA_PROFILE_DAYS=7
